# -----------------------------------------------------------------------------
# CampusFlow environment variables
# Copy to .env.local and fill in values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API (Data API / API Keys)
# Never commit .env.local.
# -----------------------------------------------------------------------------

# Public URL of the app (used for auth email redirect links).
# Local development: http://localhost:3000  — Production: https://your-domain.ma
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...) or legacy "anon" key.
# Safe to expose in the browser: every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Server-only secrets (never prefix with NEXT_PUBLIC_, never import in client code)
# -----------------------------------------------------------------------------

# Not used by Phase 1. Reserved for future server-side admin jobs (e.g. creating
# notifications). Keep it empty unless a feature explicitly requires it.
SUPABASE_SECRET_KEY=

# AI Study Assistant (Phase 4). Leave empty: the module shows a
# "not configured" state until a provider key is set on the server.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
